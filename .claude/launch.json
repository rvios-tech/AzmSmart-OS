{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "storeos",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "F:/rvios-next",
        "run",
        "dev",
        "--",
        "-p",
        "3020"
      ],
      "port": 3020
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "F:/rvios-web",
        "run",
        "dev",
        "--",
        "-p",
        "3030"
      ],
      "port": 3030
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "F:/باكند RVIOS/api",
        "run",
        "start:dev"
      ],
      "env": {
        "PORT": "3002"
      },
      "port": 3002
    },
    {
      "name": "rvos-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "F:/تطبيق ادارة منصة RVIOS/RVIOS-APP/tool/serve_web.py",
        "8087"
      ],
      "port": 8087
    }
  ]
}
# متغيّرات NEXT_PUBLIC_* تُخبز في الحزمة وقت البناء: اضبطها في الاستضافة قبل البناء،
# وأعد البناء بعد أي تغيير. بناء الإنتاج يرفض عنوان باكند محليًا (انظر next.config.ts).

# الباكند الموحّد (F:\RVIOS_APP\api) — بالبادئة /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# منصة المتاجر (RVIOS StoreOS، مشروع rvios-next) — روابط «زيارة المتجر»: <URL>/s/<slug>
NEXT_PUBLIC_STOREFRONT_URL=https://rvios.store
# المضيف الذي يوجّه إليه التاجر سجلات DNS لنطاقه الخاص (حيث تُنشر منصة المتاجر)
NEXT_PUBLIC_STOREFRONT_CNAME=rvios.store

# الصفحة الترحيبية (/) — روابطها إلى الموقع الرئيسي وموقع منصة المتاجر
NEXT_PUBLIC_RVIOS_URL=https://www.rvios.com
NEXT_PUBLIC_STOREOS_URL=https://store.rvios.com

# العنوان العام لعزم سمارت — الرابط الأساسي للصفحة الترحيبية وخريطة الموقع
NEXT_PUBLIC_SITE_URL=https://azm.rvios.com

# Google Analytics (افتراضيًا G-L8KCY9M4ZP، في الإنتاج وحده) — فارغ يعطّله
# NEXT_PUBLIC_GA_IDS=G-L8KCY9M4ZP
